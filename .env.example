# LLM provider configuration
# Ordered fallback chain. Mix providers: one provider's outage won't stop the run.
LLM_MODELS=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,google_genai:gemini-3.8-flash,google_genai:gemini-3.5-flash-liteGROQ_API_KEY=<your-groq-api-key>
GOOGLE_API_KEY=<your-google-api-key>
LLM_TEMPERATURE=0.7

LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
# Alternative provider
GROQ_API_KEY=

# System under test
BASE_URL=https://www.lu2met.ar
ACTION_TIMEOUT_MS=5000
REPORTS_DIR=reports